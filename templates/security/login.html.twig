{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    {% set input = 'mt-1 block w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-stone-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200' %}

    <div class="mx-auto max-w-md">
        <div class="rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
            <h1 class="text-2xl font-bold text-stone-900">Connexion</h1>
            <p class="mt-1 text-sm text-stone-500">Content de te revoir !</p>

            {% if error %}
                <div class="mt-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mt-6 rounded-lg border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm text-indigo-700">
                    Tu es déjà connecté en tant que {{ app.user.pseudo }}.
                    <a href="{{ path('app_logout') }}" class="font-medium underline">Se déconnecter</a>
                </div>
            {% endif %}

            <form method="post" class="mt-6 space-y-5">
                <div>
                    <label for="username" class="block text-sm font-medium text-stone-700">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username"
                           class="{{ input }}" autocomplete="email" required autofocus>
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-stone-700">Mot de passe</label>
                    <input type="password" name="_password" id="password"
                           class="{{ input }}" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <label class="flex items-center gap-2 text-sm text-stone-600">
                    <input type="checkbox" name="_remember_me" class="h-4 w-4 rounded border-stone-300 accent-indigo-600">
                    Se souvenir de moi
                </label>

                <button type="submit"
                        class="w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                    Se connecter
                </button>
            </form>

            <p class="mt-6 text-center text-sm text-stone-500">
                Pas encore de compte ?
                <a href="{{ path('app_register') }}" class="font-medium text-indigo-600 hover:text-indigo-800">S'inscrire</a>
            </p>

        </div>
    </div>
{% endblock %}
