{% extends 'base.html.twig' %}

{% block title %}{{ article.title }}{% endblock %}

{% block body %}
    {% if not article.published %}
        <div class="mb-6 flex items-center gap-3 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/>
                <path fill-rule="evenodd" d="M.66 10.59a1.65 1.65 0 0 1 0-1.18A10 10 0 0 1 10 3c4.26 0 7.9 2.66 9.34 6.41.15.38.15.8 0 1.18A10 10 0 0 1 10 17c-4.26 0-7.9-2.66-9.34-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd"/>
            </svg>
            <p>
                <strong>Aperçu</strong> ·
                {% if article.publishedAt and article.status.value == 'scheduled' %}
                    Programmé pour le {{ article.publishedAt|date('d/m/Y à H:i') }}.
                {% else %}
                    Brouillon, non visible par les lecteurs.
                {% endif %}
            </p>
        </div>
    {% endif %}

    <a href="{{ path('article_index') }}" class="text-sm text-stone-500 hover:text-indigo-600">
        ← Retour aux articles
    </a>

    <article class="mt-6">
        <header class="mb-10">
            <a href="{{ path('article_by_category', {slug: article.category.slug}) }}"
               class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-medium text-indigo-700 hover:bg-indigo-100">
                {{ article.category.name }}
            </a>

            <h1 class="mt-4 text-4xl font-bold tracking-tight text-stone-900">{{ article.title }}</h1>

            <p class="mt-3 text-stone-500">
                Par <span class="font-medium text-stone-700">{{ article.author.pseudo }}</span>
                · {{ article.publishedAt ? article.publishedAt|date('d/m/Y à H:i') : 'Non publié' }}
            </p>

            {% if is_granted('ARTICLE_EDIT', article) %}
                <a href="{{ path('admin_article_edit', {entityId: article.id}) }}"
                   class="mt-4 inline-flex items-center gap-1 rounded-lg border border-stone-300 bg-white px-3 py-1.5 text-sm font-medium text-stone-700 hover:bg-stone-100">
                    Modifier l'article
                </a>
            {% endif %}

            <div class="mt-4 flex flex-wrap gap-3">
                {% for tag in article.tags %}
                    <a href="{{ path('article_by_tag', {slug: tag.slug}) }}"
                       class="text-sm text-stone-500 hover:text-indigo-600">
                        #{{ tag.name }}
                    </a>
                {% endfor %}
            </div>
        </header>

        {% if article.image %}
            <img src="{{ asset('uploads/articles/' ~ article.image) }}"
                 alt="{{ article.title }}"
                 class="mb-10 aspect-[16/9] w-full rounded-2xl object-cover shadow-sm">
        {% endif %}

        <div class="prose prose-stone prose-lg max-w-none prose-pre:rounded-xl prose-pre:bg-[#0d1117]">
            {{ article.content|markdown }}
        </div>
    </article>

    {% if article.published %}
        {% set comments = article.approvedComments %}

        <section id="comments" class="mt-16 border-t border-stone-200 pt-10">
            <h2 class="mb-6 text-2xl font-semibold text-stone-900">
                Commentaires <span class="text-stone-400">({{ comments|length }})</span>
            </h2>

            {% if app.user %}
                <div class="mb-8 rounded-xl border border-stone-200 bg-white p-5">
                    {{ form_start(commentForm) }}
                    {{ form_row(commentForm.content) }}
                    <div class="flex justify-end">
                        <button type="submit"
                                class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                            Publier
                        </button>
                    </div>
                    {{ form_end(commentForm) }}
                </div>
            {% else %}
                <div class="mb-8 rounded-xl border border-dashed border-stone-300 p-5 text-center text-sm text-stone-500">
                    <a href="{{ path('app_login') }}" class="font-medium text-indigo-600 hover:text-indigo-800">Connecte-toi</a>
                    ou
                    <a href="{{ path('app_register') }}" class="font-medium text-indigo-600 hover:text-indigo-800">crée un compte</a>
                    pour laisser un commentaire.
                </div>
            {% endif %}

            <div class="space-y-4">
                {% for comment in comments %}
                    <div class="flex gap-4 rounded-xl border border-stone-200 bg-white p-5">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-100 font-semibold text-indigo-700">
                            {{ comment.author.pseudo|first|upper }}
                        </div>
                        <div>
                            <p class="text-sm">
                                <span class="font-medium text-stone-900">{{ comment.author.pseudo }}</span>
                                <span class="text-stone-400">· {{ comment.createdAt|date('d/m/Y') }}</span>
                            </p>
                            <p class="mt-1 leading-relaxed text-stone-600">{{ comment.content }}</p>
                        </div>
                    </div>
                {% else %}
                    <p class="text-stone-500">Aucun commentaire pour le moment.</p>
                {% endfor %}
            </div>


        </section>

    {% endif %}

{% endblock %}
