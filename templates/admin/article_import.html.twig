{% extends 'base.html.twig' %}

{% block title %}Importer des articles{% endblock %}

{% block body %}
    <a href="{{ path('admin_article_index') }}" class="text-sm text-stone-500 hover:text-indigo-600">
        ← Retour à l'administration
    </a>

    <div class="mx-auto mt-6 max-w-xl rounded-2xl border border-stone-200 bg-white p-8 shadow-sm">
        <h1 class="text-2xl font-bold text-stone-900">Importer des articles</h1>
        <p class="mt-1 text-sm text-stone-500">
            Un article dont le slug existe déjà est mis à jour, les autres sont créés.
        </p>

        {% if report %}
            <div class="mt-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">
                <strong>{{ report.created }}</strong> article(s) créé(s),
                <strong>{{ report.updated }}</strong> mis à jour.
            </div>

            {% for message in report.warnings %}
                <p class="mt-2 rounded-lg border border-amber-200 bg-amber-50 px-4 py-2 text-sm text-amber-800">{{ message }}</p>
            {% endfor %}

            {% for message in report.errors %}
                <p class="mt-2 rounded-lg border border-red-200 bg-red-50 px-4 py-2 text-sm text-red-700">{{ message }}</p>
            {% endfor %}
        {% endif %}

        <div class="mt-6">
            {{ form_start(form) }}
            {{ form_row(form.csv) }}
            {{ form_row(form.images) }}

            <button type="submit"
                    class="w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                Importer
            </button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
