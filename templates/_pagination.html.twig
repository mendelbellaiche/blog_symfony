{% if pages > 1 %}
    {% set route = app.request.attributes.get('_route') %}
    {% set params = app.request.attributes.get('_route_params')|merge(app.request.query.all) %}

    {% set base = 'inline-flex h-10 min-w-10 items-center justify-center gap-1 rounded-lg px-3 text-sm font-medium transition' %}
    {% set idle = base ~ ' border border-stone-200 bg-white text-stone-700 hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700' %}
    {% set active = base ~ ' bg-indigo-600 text-white shadow-sm' %}
    {% set disabled = base ~ ' border border-stone-100 bg-white text-stone-300 cursor-not-allowed' %}

    {% set chevron_left %}
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M12.79 5.23a.75.75 0 0 1-.02 1.06L8.83 10l3.94 3.71a.75.75 0 1 1-1.04 1.08l-4.5-4.25a.75.75 0 0 1 0-1.08l4.5-4.25a.75.75 0 0 1 1.06.02Z" clip-rule="evenodd"/>
        </svg>
    {% endset %}
    {% set chevron_right %}
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 0 1 .02-1.06L11.17 10 7.23 6.29a.75.75 0 1 1 1.04-1.08l4.5 4.25a.75.75 0 0 1 0 1.08l-4.5 4.25a.75.75 0 0 1-1.06-.02Z" clip-rule="evenodd"/>
        </svg>
    {% endset %}

    <nav class="mt-12 flex items-center justify-center gap-2" aria-label="Pagination">
        {# Précédent #}
        {% if page > 1 %}
            <a href="{{ path(route, params|merge({page: page - 1})) }}" class="{{ idle }}" aria-label="Page précédente">
                {{ chevron_left }}<span class="hidden sm:inline">Précédent</span>
            </a>
        {% else %}
            <span class="{{ disabled }}">
                {{ chevron_left }}<span class="hidden sm:inline">Précédent</span>
            </span>
        {% endif %}

        {# Numéros de page #}
        {% set last_shown = 0 %}
        {% for p in 1..pages %}
            {% if p == 1 or p == pages or (p >= page - 1 and p <= page + 1) %}
                {% if last_shown and p > last_shown + 1 %}
                    <span class="px-1 text-stone-400">…</span>
                {% endif %}

                {% if p == page %}
                    <span class="{{ active }}" aria-current="page">{{ p }}</span>
                {% else %}
                    <a href="{{ path(route, params|merge({page: p})) }}" class="{{ idle }}">{{ p }}</a>
                {% endif %}

                {% set last_shown = p %}
            {% endif %}
        {% endfor %}

        {# Suivant #}
        {% if page < pages %}
            <a href="{{ path(route, params|merge({page: page + 1})) }}" class="{{ idle }}" aria-label="Page suivante">
                <span class="hidden sm:inline">Suivant</span>{{ chevron_right }}
            </a>
        {% else %}
            <span class="{{ disabled }}">
                <span class="hidden sm:inline">Suivant</span>{{ chevron_right }}
            </span>
        {% endif %}
    </nav>
{% endif %}
